# LLM
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_FLAT=transcripts_flat
QDRANT_COLLECTION_CHILD=transcripts_child

# Postgres (parent-doc store, BM25 text search, feedback/monitoring log)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=podcast_explorer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Ingestion
# Seconds between transcript fetches. Raise this if YouTube rate-limits you.
FETCH_DELAY_SECONDS=10

# Chunks embedded per batch. Larger is faster but uses more memory.
EMBED_BATCH_SIZE=64

# Set to 1 to re-ingest episodes already in Postgres. Needed after changing
# the chunking constants, which otherwise leave existing episodes untouched.
#REINGEST=1

# Optional: route transcript fetches through a proxy. Only needed if YouTube
# blocks your IP (RequestBlocked/IpBlocked) -- e.g. after too many requests,
# or when running from a cloud provider, whose ranges YouTube blocks broadly.
# Either a Webshare residential account:
#WEBSHARE_PROXY_USERNAME=
#WEBSHARE_PROXY_PASSWORD=
# ...or any generic proxy:
#PROXY_HTTP_URL=http://user:pass@host:port
#PROXY_HTTPS_URL=http://user:pass@host:port

# Retrieval
# One of: flat | parent_document | hybrid | hybrid_rerank
RETRIEVAL_STRATEGY=hybrid_rerank
TOP_K=5

# Grafana
GF_SECURITY_ADMIN_PASSWORD=admin
