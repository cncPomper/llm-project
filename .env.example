# LLM
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Qdrant
# NOTE: `qdrant` and `postgres` below are Compose service names -- they only
# resolve inside the Compose network. Running ingestion or eval from the host
# needs localhost instead (http://localhost:6333 / localhost). Changing them
# here does not affect the app container, which gets both from the
# `environment:` block in docker-compose.yml.
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_FLAT=transcripts_flat
QDRANT_COLLECTION_CHILD=transcripts_child

# Postgres (parent-doc store, BM25 text search, feedback/monitoring log)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=podcast_explorer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Ingestion
# Seconds between transcript fetches. Raise this if YouTube rate-limits you.
FETCH_DELAY_SECONDS=10

# Chunks embedded per batch. Larger is faster but uses more memory.
EMBED_BATCH_SIZE=64

# Set to 1 to fall back to downloading the audio (yt-dlp) and transcribing it
# locally (faster-whisper) when captions are unavailable OR when YouTube blocks
# the caption endpoint for your IP. Video delivery keeps working when
# /api/timedtext returns 429, so this is the one path that survives an IP block.
# Requires ffmpeg on PATH. Slow: see WHISPER_MODEL below.
#WHISPER_FALLBACK=1

# tiny | base | small (larger = slower and more accurate). Measured on a
# 16-core CPU: tiny 2.7x realtime, base 1.6x, small 0.7x -- so `small` takes
# longer than the episode's own runtime. `base` is the default.
#WHISPER_MODEL=base

# Set to 1 to re-ingest episodes already in Postgres. Needed after changing
# the chunking constants or the ad filter, which otherwise leave existing
# episodes untouched. A forced re-ingest purges the episode from Postgres and
# Qdrant first, so no stale chunks survive.
#REINGEST=1

# Sponsor reads are stripped from transcripts before chunking (on by default).
# Set to 0 to index them like any other speech. Dry run to see what it removes:
#   uv run python -m ingestion.ad_filter
#STRIP_ADS=0

# Optional: route transcript fetches through a proxy. Only needed if YouTube
# blocks your IP (RequestBlocked/IpBlocked) -- e.g. after too many requests,
# or when running from a cloud provider, whose ranges YouTube blocks broadly.
# Either a Webshare residential account:
#WEBSHARE_PROXY_USERNAME=
#WEBSHARE_PROXY_PASSWORD=
# ...or any generic proxy:
#PROXY_HTTP_URL=http://user:pass@host:port
#PROXY_HTTPS_URL=http://user:pass@host:port

# Retrieval
# One of: flat | parent_document | hybrid | hybrid_rerank
RETRIEVAL_STRATEGY=hybrid_rerank
TOP_K=5

# Grafana
GF_SECURITY_ADMIN_PASSWORD=admin
